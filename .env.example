APP_NAME="Punto Actual"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://puntoactual.pe
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=punto_actual
DB_USERNAME=punto_user
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@puntoactual.pe"
MAIL_FROM_NAME="${APP_NAME}"

# Imágenes (Cloudinary, misma cuenta que Bravera; carpeta punto-actual)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_SECURE=true

# Redes sociales
SOCIAL_FACEBOOK_URL=https://www.facebook.com/puntoactual
SOCIAL_INSTAGRAM_URL=https://www.instagram.com/puntoactual
SOCIAL_TIKTOK_URL=https://www.tiktok.com/@puntoactual
SOCIAL_X_URL=
SOCIAL_YOUTUBE_URL=
SITE_DEFAULT_IMAGE=

# Google Indexing API (service account JSON)
GOOGLE_INDEXING_ENABLED=false
GOOGLE_APPLICATION_CREDENTIALS=

# API (usar: Authorization: Bearer <token>)
API_TOKEN=

# Analítica y verificación
ANALYTICS_ENABLED=true
GOOGLE_ANALYTICS_ID=
GOOGLE_TAG_MANAGER_ID=
MICROSOFT_CLARITY_ID=
META_PIXEL_ID=
TIKTOK_PIXEL_ID=
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
